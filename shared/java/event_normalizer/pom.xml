<!--
STAR
Situation: Some enterprise big data teams still use Java for stable high throughput components.
Task: Provide a small Java module that normalizes event fields before downstream ingestion.
Action: Use Jackson to parse JSON and enforce consistent field names.
Result: Demonstrates Java readiness alongside Python and PySpark.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.anand.portfolio</groupId>
  <artifactId>event-normalizer</artifactId>
  <version>1.0.0</version>
  <properties>
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
  </properties>
  <dependencies>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>2.17.2</version>
    </dependency>
  </dependencies>
</project>
